    "ioredis": "^5.11.1",
    "log4js": "^6.9.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "mocha": "^12.0.2",
    "pm2": "^7.0.4",
    "socket.io-client": "^4.8.3",
    "standard": "^17.1.2"
